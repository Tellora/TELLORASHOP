# Copy to .env.local (development) or set these in your hosting dashboard (production).
# The admin panel's Store Settings > Launch Readiness checklist shows which are set.

# REQUIRED in production: a long random string (for example: openssl rand -hex 32).
# Without it, login is disabled in production on purpose.
JWT_SECRET=

# Your public address, no trailing slash. Used in emails, the sitemap and payment redirects.
NEXT_PUBLIC_SITE_URL=https://yourshop.com

# Email (https://resend.com). Order confirmations, shipping updates, password resets, contact notifications.
RESEND_API_KEY=
EMAIL_FROM=Your Shop <orders@yourshop.com>

# Card payments (https://dashboard.stripe.com/apikeys). Leave blank to offer cash on delivery only.
STRIPE_SECRET_KEY=
# Create a webhook to https://yourshop.com/api/stripe/webhook (events: checkout.session.completed, checkout.session.expired)
STRIPE_WEBHOOK_SECRET=
